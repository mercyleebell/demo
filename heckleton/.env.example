# Heckleton configuration
# Copy this file to .env (or just export these in your shell) before `npm start`.

# Required for live mode. Without it, Heckleton runs in DEMO MODE:
# the whole UI works, but critiques come from a local heuristic instead of Claude.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-8 (Anthropic's most capable Opus-tier model).
# You can drop to claude-sonnet-4-6 for faster/cheaper roasts.
HECKLETON_MODEL=claude-opus-4-8

# Optional. Port for the dashboard. Defaults to 4173.
PORT=4173
